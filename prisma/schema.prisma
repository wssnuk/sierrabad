generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  username String @unique
  password String
  name     String
  role     String @default("MANAGER")
}

model Member {
  id          String       @id @default(cuid())
  name        String
  courtFee    Int          @default(0)
  createdAt   DateTime     @default(now())
  checkIns    CheckIn[]
  gamePlayers GamePlayer[]
}

model Session {
  id                 String    @id @default(cuid())
  date               DateTime  @default(now())
  courtName          String
  shuttlePrice       Int
  status             String    @default("OPEN")
  actualCourtFeePaid Int?
  actualShuttleCount Int?
  lastEditedAt       DateTime?
  lastEditedBy       String?
  createdBy          String?
  checkIns           CheckIn[]
  games              Game[]
}

model CheckIn {
  id               String   @id @default(cuid())
  sessionId        String
  memberId         String
  checkedInAt      DateTime @default(now())
  courtFeeOverride Int?
  member           Member   @relation(fields: [memberId], references: [id])
  session          Session  @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, memberId])
  @@index([memberId])
}

model Game {
  id            String       @id @default(cuid())
  sessionId     String
  courtName     String
  shuttleCount  Int          @default(1)
  createdAt     DateTime     @default(now())
  shuttleNumber String?
  session       Session      @relation(fields: [sessionId], references: [id])
  players       GamePlayer[]

  @@index([sessionId])
}

model GamePlayer {
  id       String @id @default(cuid())
  gameId   String
  memberId String
  team     Int    @default(0)
  game     Game   @relation(fields: [gameId], references: [id])
  member   Member @relation(fields: [memberId], references: [id])

  @@index([gameId])
  @@index([memberId])
}

model Settings {
  id                     String  @id @default("singleton")
  telegramBotToken       String?
  telegramChatId         String?
  notificationEmail      String?
  resendApiKey           String?
  lineChannelAccessToken String?
  lineGroupId            String?
}
